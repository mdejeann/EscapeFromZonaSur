# Godot 4 — .gitignore
# https://github.com/github/gitignore/blob/main/Godot.gitignore

# Godot cache and generated files
.godot/
*.uid

# Godot export builds
builds/
exports/

# Import files generated by Godot editor (track .import files for assets)
# Uncomment the next line if you want to exclude ALL import files:
# *.import

# Mono/C# build artifacts (if using C#)
.mono/
data_*/
mono_crash.*.json

# macOS
.DS_Store

# Windows
Thumbs.db
desktop.ini

# Linux
*~

# VSCode
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/

# Temporary files
/tmp/
*.tmp
*.bak
*.swp

# Log files
*.log

# Node modules (if using any JS tooling)
node_modules/

# Python virtual envs (if using any Python tooling)
.venv/
__pycache__/
